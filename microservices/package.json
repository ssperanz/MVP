{
  "name": "microservices",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "npm-run-all test:centralSystem test:authentication test:warehouse test:warehouse-aggregator",
    "test:warehouse": "cd warehouse && npm test",
    "test:centralSystem": "cd centralized/CentralSystem && npm test",
    "test:authentication": "cd centralized/authentication && npm test",
    "test:warehouse-aggregator": "cd warehouse-aggregator && npm test",
    "test:cov": "npm-run-all test:cov:centralSystem test:cov:authentication test:cov:warehouse-aggregator test:cov:warehouse",
    "test:cov:warehouse": "cd warehouse && npm run test:cov",
    "test:cov:centralSystem": "cd centralized/CentralSystem && npm run test:cov",
    "test:cov:authentication": "cd centralized/authentication && npm run test:cov",
    "test:cov:warehouse-aggregator": "cd warehouse-aggregator && npm run test:cov",
    "test:debug": "npm-run-all test:debug:warehouse",
    "test:debug:warehouse": "cd warehouse && npm run test:debug",
    "test:debug:centralSystem": "cd centralized/CentralSystem && npm run test:debug",
    "test:e2e": "npm-run-all test:e2e:warehouse",
    "test:e2e:warehouse": "cd warehouse && npm run test:e2e"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "dependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/microservices": "^11.1.19",
    "@nestjs/mongoose": "^11.0.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "mongoose": "^9.6.1",
    "nats": "^2.29.3"
  }
}
